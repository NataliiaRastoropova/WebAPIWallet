@model WalletAPI.MVC.Models.AccountModels.AccountViewModel

@{
    ViewData["Title"] = "Account Details";
}

<h2>Account Details</h2>

<div class="card">
    <div class="card-body">
        <p><strong>Balance:</strong> @Model.Amount</p>
        <p><strong>Type:</strong> @Model.Type</p>
        <p><strong>Currency:</strong> @Model.Currency</p>
        <p><strong>Bank:</strong> @Model.BankType</p>
        <p><strong>Last Modified:</strong> @Model.LastModified</p>
    </div>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</p>