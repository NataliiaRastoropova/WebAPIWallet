@model IEnumerable<WalletAPI.MVC.Models.AccountModels.AccountViewModel>

@{
    ViewData["Title"] = "Accounts";
}

<h2>Accounts</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Account</a>
</p>

<table class="table table-striped">
    <thead>
    <tr>
        <th>AccountName</th>
        <th>Balance</th>
        <th>Type</th>
        <th>Currency</th>
        <th>Bank</th>
        <th>Last Modified</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Amount</td>
            <td>@item.Type</td>
            <td>@item.Currency</td>
            <td>@item.BankType</td>
            <td>@item.LastModified.ToString("yyyy-MM-dd HH:mm")</td>
            <td>
                <a asp-controller="Transaction" asp-action="ByAccount" asp-route-accountId="@item.Id" class="btn btn-secondary btn-sm">
                    Transactions
                </a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm"
                            onclick="return confirm('Are you sure?')">
                        Delete
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>