@using WalletAPI.Infrastructure.Enums
@model WalletAPI.MVC.Models.AccountModels.CreateAccountViewModel

@{
    ViewData["Title"] = "Create Account";
}

<h2>Create Account</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" class="form-control"/>
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" class="form-select"
                asp-items="Html.GetEnumSelectList<AccountType>()"></select>
    </div>

    <div class="mb-3">
        <label asp-for="Currency" class="form-label"></label>
        <select asp-for="Currency" class="form-select"
                asp-items="Html.GetEnumSelectList<CurrencyType>()"></select>
    </div>

    <div class="mb-3">
        <label asp-for="BankType" class="form-label"></label>
        <select asp-for="BankType" class="form-select"
                asp-items="Html.GetEnumSelectList<BankType>()"></select>
    </div>

    <button type="submit" class="btn btn-success">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>